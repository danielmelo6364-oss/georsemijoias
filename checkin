<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Géor — Check-in</title>
<style>
*{box-sizing:border-box;margin:0;padding:0;}
:root{--rose:#c9748a;--rose-light:#f7e8ec;--rose-dark:#9e4f63;--gold:#b8860b;--dark:#1a1a2e;--brown:#4a3728;--text:#2d2d2d;--muted:#9e8575;--bg:#fdf5f7;}
body{font-family:'Segoe UI',sans-serif;background:var(--bg);color:var(--text);min-height:100vh;}
.login-screen{min-height:100vh;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#1a1a2e 0%,#9e4f63 60%,#c9748a 100%);}
.login-box{background:#fff;border-radius:24px;padding:44px 38px;width:100%;max-width:390px;box-shadow:0 24px 64px rgba(0,0,0,.25);text-align:center;}
.geor-logo{font-size:38px;font-weight:900;letter-spacing:4px;background:linear-gradient(135deg,var(--rose-dark),var(--gold));-webkit-background-clip:text;-webkit-text-fill-color:transparent;margin-bottom:4px;}
.login-box .sub{font-size:12px;color:var(--muted);margin-bottom:28px;letter-spacing:1px;}
.lf{margin-bottom:16px;text-align:left;}
.lf label{display:block;font-size:11px;font-weight:700;color:var(--rose-dark);margin-bottom:5px;text-transform:uppercase;}
.lf input{width:100%;padding:11px 14px;border:1.5px solid #e0d0d5;border-radius:10px;font-size:14px;font-family:inherit;background:#fdf5f7;}
.lf input:focus{outline:none;border-color:var(--rose);}
.btn-login{width:100%;padding:13px;border:none;border-radius:10px;background:linear-gradient(135deg,var(--rose),var(--rose-dark));color:#fff;font-size:15px;font-weight:700;cursor:pointer;margin-top:8px;box-shadow:0 6px 20px rgba(201,116,138,.4);}
.login-error{color:#dc3545;font-size:12px;margin-top:10px;display:none;}
.sistema{display:none;}
header{background:linear-gradient(135deg,var(--dark),var(--rose-dark));color:#fff;padding:14px 28px;display:flex;align-items:center;justify-content:space-between;box-shadow:0 3px 16px rgba(0,0,0,.25);flex-wrap:wrap;gap:10px;}
.h-left{display:flex;align-items:center;gap:14px;}
.h-logo{font-size:22px;font-weight:900;letter-spacing:3px;background:linear-gradient(135deg,#f7e8ec,#f0c8d4);-webkit-background-clip:text;-webkit-text-fill-color:transparent;}
.h-title{font-size:13px;opacity:.8;}
.h-right{display:flex;align-items:center;gap:10px;flex-wrap:wrap;}
.user-badge{background:rgba(255,255,255,.15);border-radius:20px;padding:5px 14px;font-size:12px;font-weight:600;}
.admin-tag{background:var(--gold);border-radius:12px;padding:2px 8px;font-size:10px;font-weight:700;margin-left:5px;}
.btn-logout{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.3);color:#fff;padding:5px 12px;border-radius:8px;font-size:12px;cursor:pointer;}
.tabs{display:flex;background:#fff;border-bottom:2px solid var(--rose-light);padding:0 28px;box-shadow:0 2px 8px rgba(0,0,0,.05);flex-wrap:wrap;}
.tab{padding:13px 20px;font-size:13px;font-weight:600;cursor:pointer;color:var(--muted);border-bottom:3px solid transparent;margin-bottom:-2px;transition:all .2s;white-space:nowrap;}
.tab.active{color:var(--rose-dark);border-bottom-color:var(--rose);}
.tab:hover{color:var(--rose);}
.painel{display:none;padding:24px 28px;max-width:1200px;margin:0 auto;}
.painel.active{display:block;}
.card{background:#fff;border-radius:16px;padding:24px;box-shadow:0 4px 20px rgba(0,0,0,.07);}
.card h2{font-size:15px;font-weight:700;color:var(--brown);margin-bottom:20px;padding-bottom:12px;border-bottom:2px solid var(--rose-light);}
.grid-form{display:grid;grid-template-columns:430px 1fr;gap:24px;align-items:start;}
@media(max-width:860px){.grid-form{grid-template-columns:1fr;}}
.field{margin-bottom:14px;}
.field label{display:block;font-size:11px;font-weight:700;color:var(--rose-dark);margin-bottom:5px;text-transform:uppercase;letter-spacing:.4px;}
input[type=text],input[type=number],input[type=date],select,textarea{width:100%;padding:9px 13px;border:1.5px solid #e0d0d5;border-radius:8px;font-size:13px;color:var(--text);background:#fdf5f7;transition:border-color .2s;font-family:inherit;}
input:focus,select:focus,textarea:focus{outline:none;border-color:var(--rose);background:#fff;}
textarea{resize:vertical;min-height:64px;}
.row2{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
.row3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;}
.modo-toggle{display:flex;gap:0;margin-bottom:14px;border-radius:10px;overflow:hidden;border:2px solid #e0d0d5;}
.modo-toggle button{flex:1;padding:9px 6px;border:none;background:#fdf5f7;font-size:12px;font-weight:700;cursor:pointer;color:var(--muted);transition:all .2s;}
.modo-toggle button.ativo{background:linear-gradient(135deg,var(--rose),var(--rose-dark));color:#fff;}
.modo-toggle button:first-child{border-right:1px solid #e0d0d5;}
.bloco-geral{display:block;}
.bloco-variacao{display:none;}
.var-row{background:#fdf5f7;border:1.5px solid #e8d0d8;border-radius:10px;padding:12px 14px;margin-bottom:10px;}
.var-row .vt{font-size:11px;font-weight:800;color:var(--rose-dark);text-transform:uppercase;letter-spacing:.5px;margin-bottom:10px;}
.var-row .vc{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
.var-row .vc label{font-size:10px;font-weight:700;color:var(--muted);display:block;margin-bottom:3px;text-transform:uppercase;}
.var-row .vc input{background:#fff;}
.preview-total{background:var(--rose-light);border-radius:8px;padding:9px 13px;font-size:12px;color:var(--rose-dark);font-weight:700;text-align:center;margin-top:6px;}
.foto-area{border:2px dashed #e0c0cc;border-radius:10px;padding:18px;text-align:center;cursor:pointer;position:relative;background:#fdf5f7;transition:all .2s;}
.foto-area:hover{border-color:var(--rose);background:#fceef2;}
.foto-area input[type=file]{position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%;}
.foto-area .icon{font-size:28px;margin-bottom:4px;}
.foto-area p{font-size:11px;color:var(--muted);}
#preview-img{width:100%;max-height:160px;object-fit:cover;border-radius:8px;margin-top:8px;display:none;}
.btn{padding:10px 18px;border:none;border-radius:8px;font-size:13px;font-weight:700;cursor:pointer;transition:transform .1s;}
.btn-primary{background:linear-gradient(135deg,var(--rose),var(--rose-dark));color:#fff;box-shadow:0 4px 14px rgba(201,116,138,.35);width:100%;padding:12px;}
.btn-primary:hover{transform:translateY(-1px);}
.btn-danger{background:#dc3545;color:#fff;font-size:11px;padding:4px 10px;border-radius:6px;border:none;cursor:pointer;}
.btn-warning{background:#fd7e14;color:#fff;font-size:11px;padding:4px 10px;border-radius:6px;border:none;cursor:pointer;}
.btn-success{background:#28a745;color:#fff;font-size:11px;padding:4px 10px;border-radius:6px;border:none;cursor:pointer;}
.btn-dark{background:var(--dark);color:#f7e8ec;font-size:12px;padding:7px 14px;border:none;border-radius:8px;cursor:pointer;}
.stats-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(110px,1fr));gap:10px;margin-bottom:20px;}
.stat-box{background:#fff;border-radius:12px;padding:14px 16px;text-align:center;box-shadow:0 2px 10px rgba(0,0,0,.06);border-top:3px solid var(--rose);}
.stat-box .num{font-size:24px;font-weight:800;color:var(--rose-dark);}
.stat-box .lbl{font-size:10px;color:var(--muted);margin-top:2px;text-transform:uppercase;letter-spacing:.4px;}
.stat-box.warn .num{color:#fd7e14;}
.stat-box.warn{border-top-color:#fd7e14;}
.alerta-estoque{background:#fff3cd;border:1px solid #ffc107;border-radius:10px;padding:12px 16px;margin-bottom:16px;font-size:13px;color:#856404;}
.alerta-estoque strong{display:block;margin-bottom:6px;font-size:14px;}
.alerta-item{padding:3px 0;border-bottom:1px solid #ffe69c;}
.alerta-item:last-child{border:none;}
.filtros{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px;align-items:center;}
.filtros select,.filtros input{padding:7px 12px;border:1.5px solid #e0d0d5;border-radius:8px;font-size:12px;background:#fff;font-family:inherit;}
.hist-wrap{max-height:65vh;overflow-y:auto;padding-right:4px;}
.hist-wrap::-webkit-scrollbar{width:4px;}
.hist-wrap::-webkit-scrollbar-thumb{background:var(--rose-light);border-radius:10px;}
.entry{background:#fff;border-radius:12px;padding:14px;margin-bottom:10px;box-shadow:0 2px 8px rgba(0,0,0,.06);display:grid;grid-template-columns:72px 1fr auto;gap:12px;align-items:start;border-left:4px solid var(--rose-light);transition:box-shadow .2s;}
.entry:hover{box-shadow:0 4px 16px rgba(0,0,0,.1);border-left-color:var(--rose);}
.entry.alerta-low{border-left-color:#fd7e14;}
.entry img{width:72px;height:72px;object-fit:cover;border-radius:8px;}
.entry .no-img{width:72px;height:72px;border-radius:8px;background:var(--rose-light);display:flex;align-items:center;justify-content:center;font-size:22px;}
.entry-info h3{font-size:13px;font-weight:700;margin-bottom:3px;}
.entry-info .ref{font-size:10px;color:var(--muted);font-family:monospace;margin-bottom:4px;}
.entry-info .meta{font-size:11px;color:var(--muted);margin-bottom:5px;}
.entry-info .obs{font-size:11px;color:var(--brown);font-style:italic;margin-top:3px;}
.entry-info .reg-por{font-size:10px;color:var(--rose-dark);font-weight:600;margin-top:3px;}
.pills{display:flex;gap:6px;flex-wrap:wrap;margin-top:5px;}
.pill{border-radius:6px;padding:2px 9px;font-size:11px;font-weight:600;background:var(--rose-light);color:var(--rose-dark);}
.pill.gondola{background:#e8f5e9;color:#2e7d32;}
.pill.estoque{background:#e3f2fd;color:#1565c0;}
.pill.total{background:#f3e5f5;color:#6a1b9a;}
.pill.low{background:#fff3e0;color:#e65100;}
.pill.prata{background:#e8e8f0;color:#3a3a6e;}
.pill.dourado{background:#fff8e1;color:#7a5500;}
.pill.rosegold{background:#fce4ec;color:#9e4f63;}
.tipo-badge{display:inline-block;padding:1px 9px;border-radius:12px;font-size:10px;font-weight:700;}
.tipo-Joia{background:#fff3cd;color:#856404;}
.tipo-Bijuteria{background:#d1ecf1;color:#0c5460;}
.tipo-Semijoia{background:#f8d7da;color:#721c24;}
.tipo-Acessório{background:#d4edda;color:#155724;}
.tipo-Outro{background:#e2e3e5;color:#383d41;}
.entry-actions{display:flex;flex-direction:column;align-items:flex-end;gap:5px;}
.var-detalhe{margin-top:8px;background:#fdf5f7;border-radius:8px;padding:8px 10px;}
.var-detalhe .vd-title{font-size:10px;font-weight:800;color:var(--rose-dark);text-transform:uppercase;margin-bottom:6px;}
.var-linha{display:flex;justify-content:space-between;font-size:11px;padding:3px 0;border-bottom:1px dashed #f0dde3;}
.var-linha:last-child{border:none;}
.var-nome{font-weight:700;color:var(--brown);}
.var-qtds{color:var(--muted);}
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.55);display:none;align-items:center;justify-content:center;z-index:200;}
.modal-overlay.open{display:flex;}
.repor-box{background:#fff;border-radius:16px;padding:28px;width:90%;max-width:420px;box-shadow:0 16px 48px rgba(0,0,0,.2);text-align:center;}
.repor-box h3{font-size:16px;font-weight:700;color:var(--brown);margin-bottom:6px;}
.repor-box p{font-size:12px;color:var(--muted);margin-bottom:16px;}
.repor-info{background:var(--rose-light);border-radius:8px;padding:10px;font-size:13px;margin-bottom:16px;color:var(--rose-dark);line-height:1.8;text-align:left;}
.var-sel-label{font-size:11px;font-weight:700;color:var(--rose-dark);text-transform:uppercase;margin-bottom:6px;display:block;text-align:left;}
.var-sel-group{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px;}
.var-sel-btn{padding:8px 12px;border:2px solid #e0d0d5;border-radius:8px;font-size:12px;font-weight:700;cursor:pointer;background:#fdf5f7;transition:all .2s;}
.var-sel-btn.ativo{border-color:var(--rose);background:var(--rose-light);color:var(--rose-dark);}
.repor-box input[type=number]{width:100%;padding:10px;border:1.5px solid #e0d0d5;border-radius:8px;font-size:18px;text-align:center;margin-bottom:14px;background:#fdf5f7;}
.repor-btns{display:flex;gap:10px;}
.repor-btns button{flex:1;padding:11px;border:none;border-radius:8px;font-size:13px;font-weight:700;cursor:pointer;}
.repor-ok{background:linear-gradient(135deg,var(--rose),var(--rose-dark));color:#fff;}
.repor-cancel{background:#f0f0f0;color:#666;}
.edit-overlay{position:fixed;inset:0;background:rgba(0,0,0,.55);display:none;align-items:center;justify-content:center;z-index:300;}
.edit-overlay.open{display:flex;}
.edit-box{background:#fff;border-radius:16px;padding:28px;width:94%;max-width:540px;box-shadow:0 16px 48px rgba(0,0,0,.25);max-height:90vh;overflow-y:auto;}
.edit-box h3{font-size:16px;font-weight:700;color:var(--brown);margin-bottom:18px;}
.periodo-form{display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap;background:#fff;border-radius:12px;padding:16px;box-shadow:0 2px 8px rgba(0,0,0,.06);margin-bottom:20px;}
.periodo-form .pf{display:flex;flex-direction:column;gap:4px;}
.periodo-form label{font-size:11px;font-weight:700;color:var(--rose-dark);text-transform:uppercase;}
.periodo-form input,.periodo-form select{padding:8px 12px;border:1.5px solid #e0d0d5;border-radius:8px;font-size:13px;background:#fdf5f7;}
.rel-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:14px;margin-bottom:20px;}
.rel-card{background:#fff;border-radius:12px;padding:16px;box-shadow:0 2px 10px rgba(0,0,0,.06);border-top:3px solid var(--rose);}
.rel-card h4{font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.4px;margin-bottom:8px;}
.rel-card .big{font-size:28px;font-weight:800;color:var(--rose-dark);}
.rel-card .desc{font-size:11px;color:var(--muted);margin-top:2px;}
.rel-table{width:100%;border-collapse:collapse;font-size:12px;}
.rel-table th{background:var(--rose-light);color:var(--rose-dark);padding:8px 10px;text-align:left;font-size:11px;text-transform:uppercase;letter-spacing:.4px;}
.rel-table td{padding:8px 10px;border-bottom:1px solid #f5eef0;}
.rel-table tr:hover td{background:#fdf5f7;}
#toast{position:fixed;bottom:24px;right:24px;background:var(--dark);color:#f7e8ec;padding:11px 18px;border-radius:10px;font-size:13px;font-weight:600;opacity:0;transform:translateY(8px);transition:all .3s;z-index:999;pointer-events:none;}
#toast.show{opacity:1;transform:translateY(0);}
.empty{text-align:center;color:#d4a0b0;font-size:13px;padding:36px 20px;}
.empty .icon{font-size:36px;margin-bottom:8px;}
.mov-lista{margin-top:6px;font-size:11px;color:var(--muted);}
.mov-item{padding:2px 0;border-top:1px dashed #f0e0e5;}
</style>
</head>
<body>

<div class="login-screen" id="login-screen">
  <div class="login-box">
    <div class="geor-logo">GÉOR</div>
    <div class="sub">SEMIJOIAS & ACESSÓRIOS</div>
    <div class="lf"><label>Usuário</label><input type="text" id="l-user" placeholder="Digite seu usuário"/></div>
    <div class="lf"><label>Senha</label><input type="password" id="l-pass" placeholder="Digite sua senha" onkeydown="if(event.key==='Enter')login()"/></div>
    <button class="btn-login" onclick="login()">🔐 Entrar</button>
    <div class="login-error" id="login-error">Usuário ou senha incorretos.</div>
  </div>
</div>

<div class="sistema" id="sistema">
  <header>
    <div class="h-left">
      <div class="h-logo">GÉOR</div>
      <div class="h-title">Sistema de Check-in</div>
    </div>
    <div class="h-right">
      <div class="user-badge" id="user-badge">👤 —</div>
      <button class="btn-logout" onclick="logout()">Sair</button>
    </div>
  </header>

  <div class="tabs">
    <div class="tab active" onclick="aba('checkin')">📦 Check-in</div>
    <div class="tab" onclick="aba('estoque')">🗄️ Estoque</div>
    <div class="tab" onclick="aba('relatorio')">📊 Relatório</div>
    <div class="tab admin-tab" onclick="aba('admin')" style="display:none">⚙️ Admin</div>
  </div>

  <!-- CHECK-IN -->
  <div class="painel active" id="tab-checkin">
    <div class="grid-form">
      <div class="card">
        <h2>📦 Novo Registro</h2>
        <div class="field">
          <label>Foto do Produto</label>
          <div class="foto-area">
            <input type="file" accept="image/*" id="foto-input"/>
            <div class="icon">📷</div>
            <p>Clique para adicionar foto</p>
          </div>
          <img id="preview-img" alt="Preview"/>
        </div>
        <div class="field"><label>Nome / Descrição *</label><input type="text" id="f-nome" placeholder="Ex: Anel Solitário Banhado a Ouro"/></div>
        <div class="row2">
          <div class="field"><label>Código / Referência</label><input type="text" id="f-ref" placeholder="Ex: GR-001"/></div>
          <div class="field"><label>Tipo *</label>
            <select id="f-tipo">
              <option value="">Selecione...</option>
              <option value="Joia">💛 Joia</option>
              <option value="Bijuteria">💙 Bijuteria</option>
              <option value="Semijoia">❤️ Semijoia</option>
              <option value="Acessório">💚 Acessório</option>
              <option value="Outro">⚪ Outro</option>
            </select>
          </div>
        </div>
        <div class="field"><label>Fornecedor / Origem</label><input type="text" id="f-forn" placeholder="Ex: Fornecedor SP"/></div>

        <div class="field">
          <label>Como informar as quantidades?</label>
          <div class="modo-toggle">
            <button type="button" id="btn-modo-geral" class="ativo" onclick="setModo('geral')">📦 Quantidade Geral</button>
            <button type="button" id="btn-modo-var" onclick="setModo('variacao')">🔘✨ Por Acabamento</button>
          </div>
        </div>

        <!-- GERAL -->
        <div class="bloco-geral" id="bloco-geral">
          <div class="row3">
            <div class="field"><label>Qtd. Gôndola</label><input type="number" id="f-gondola" min="0" placeholder="0" oninput="prevGeral()"/></div>
            <div class="field"><label>Qtd. Estoque</label><input type="number" id="f-estoque" min="0" placeholder="0" oninput="prevGeral()"/></div>
            <div class="field"><label>Alertar abaixo de</label><input type="number" id="f-alerta" min="0" placeholder="5"/></div>
          </div>
          <div class="preview-total" id="prev-geral" style="display:none"></div>
        </div>

        <!-- VARIAÇÃO -->
        <div class="bloco-variacao" id="bloco-variacao">
          <div class="var-row">
            <div class="vt">🔘 Prata</div>
            <div class="vc">
              <div><label>Gôndola</label><input type="number" id="vp-g" min="0" placeholder="0" oninput="prevVar()"/></div>
              <div><label>Estoque</label><input type="number" id="vp-e" min="0" placeholder="0" oninput="prevVar()"/></div>
            </div>
          </div>
          <div class="var-row">
            <div class="vt">✨ Dourado</div>
            <div class="vc">
              <div><label>Gôndola</label><input type="number" id="vd-g" min="0" placeholder="0" oninput="prevVar()"/></div>
              <div><label>Estoque</label><input type="number" id="vd-e" min="0" placeholder="0" oninput="prevVar()"/></div>
            </div>
          </div>
          <div class="var-row">
            <div class="vt">🌸 Rose Gold</div>
            <div class="vc">
              <div><label>Gôndola</label><input type="number" id="vr-g" min="0" placeholder="0" oninput="prevVar()"/></div>
              <div><label>Estoque</label><input type="number" id="vr-e" min="0" placeholder="0" oninput="prevVar()"/></div>
            </div>
          </div>
          <div class="field" style="margin-top:6px;"><label>Alertar abaixo de (total)</label><input type="number" id="f-alerta-v" min="0" placeholder="5"/></div>
          <div class="preview-total" id="prev-var"></div>
        </div>

        <div class="field" style="margin-top:6px;"><label>Observações</label><textarea id="f-obs" placeholder="Cor, tamanho, coleção..."></textarea></div>
        <button class="btn btn-primary" onclick="registrar()">✅ Registrar Check-in</button>
      </div>

      <div>
        <div class="stats-grid" id="stats-checkin"></div>
        <div id="alertas-top"></div>
        <div class="card" style="padding:20px;">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;flex-wrap:wrap;gap:8px;">
            <h2 style="margin:0;padding:0;border:none;font-size:15px;font-weight:700;color:var(--brown);">📋 Histórico de Entradas</h2>
            <button class="btn-dark" onclick="exportarCSV()">⬇️ Exportar CSV</button>
          </div>
          <div class="filtros">
            <select id="ft-tipo" onchange="renderCheckin()">
              <option value="">Todos os tipos</option>
              <option value="Joia">Joia</option><option value="Bijuteria">Bijuteria</option>
