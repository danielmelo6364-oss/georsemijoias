<div id="toast"></div>
<script>
const USERS={
  admin:{senha:'geor2024',nome:'Administrador',isAdmin:true},
  hellen:{senha:'hellen123',nome:'Hellen',isAdmin:false}
};
let USER=null,reporId=null,relFiltrado=[],modoAtual='geral';

function login(){
  const u=document.getElementById('l-user').value.trim().toLowerCase();
  const s=document.getElementById('l-pass').value;
  const err=document.getElementById('login-error');
  if(USERS[u]&&USERS[u].senha===s){
    USER={login:u,...USERS[u]};
    err.style.display='none';
    document.getElementById('login-screen').style.display='none';
    document.getElementById('sistema').style.display='block';
    document.getElementById('user-badge').innerHTML=
      `👤 ${USER.nome}${USER.isAdmin?'<span class="admin-tag">ADMIN</span>':''}`;
    if(USER.isAdmin) document.querySelectorAll('.admin-tab').forEach(el=>el.style.display='');
    const hoje=new Date(),ini=new Date(hoje.getFullYear(),hoje.getMonth(),1);
    document.getElementById('r-inicio').value=ini.toISOString().slice(0,10);
    document.getElementById('r-fim').value=hoje.toISOString().slice(0,10);
    atualizar();
  } else { err.style.display='block'; }
}

function logout(){
  USER=null;
  document.getElementById('login-screen').style.display='flex';
  document.getElementById('sistema').style.display='none';
  document.getElementById('l-user').value='';
  document.getElementById('l-pass').value='';
}

// MODO QUANTIDADE
function setModo(modo){
  modoAtual=modo;
  document.getElementById('btn-modo-geral').classList.toggle('ativo',modo==='geral');
  document.getElementById('btn-modo-var').classList.toggle('ativo',modo==='variacao');
  document.getElementById('bloco-geral').style.display=modo==='geral'?'block':'none';
  document.getElementById('bloco-variacao').style.display=modo==='variacao'?'block':'none';
}

function prevGeral(){
  const g=parseInt(document.getElementById('f-gondola').value)||0;
  const e=parseInt(document.getElementById('f-estoque').value)||0;
  const el=document.getElementById('prev-geral');
  if(g===0&&e===0){el.style.display='none';return;}
  el.style.display='block';
  el.textContent=`∑ Total: ${g+e} un. | 🛒 Gôndola: ${g} | 📦 Estoque: ${e}`;
}

function prevVar(){
  const pg=n('vp-g'),pe=n('vp-e'),dg=n('vd-g'),de=n('vd-e'),rg=n('vr-g'),re=n('vr-e');
  const tG=pg+dg+rg,tE=pe+de+re;
  document.getElementById('prev-var').textContent=
    `∑ Total: ${tG+tE} un. | 🛒 Gôndola: ${tG} | 📦 Estoque: ${tE}`;
}

function n(id){return parseInt(document.getElementById(id).value)||0;}

// ABAS
function aba(id){
  document.querySelectorAll('.tab').forEach((t,i)=>{
    t.classList.toggle('active',['checkin','estoque','relatorio','admin'][i]===id);
  });
  document.querySelectorAll('.painel').forEach(p=>p.classList.remove('active'));
  document.getElementById('tab-'+id).classList.add('active');
  if(id==='estoque') renderEstoque();
  if(id==='relatorio') gerarRelatorio();
  if(id==='admin') renderAdmin();
}

// DADOS
function getData(){return JSON.parse(localStorage.getItem('geor_v3')||'[]');}
function setData(d){localStorage.setItem('geor_v3',JSON.stringify(d));}

// FOTO
let fotoB64=null;
document.getElementById('foto-input').addEventListener('change',function(e){
  const f=e.target.files[0];if(!f)return;
  const r=new FileReader();
  r.onload=ev=>{fotoB64=ev.target.result;const img=document.getElementById('preview-img');img.src=fotoB64;img.style.display='block';};
  r.readAsDataURL(f);
});

// REGISTRAR
function registrar(){
  const nome=document.getElementById('f-nome').value.trim();
  const ref=document.getElementById('f-ref').value.trim();
  const tipo=document.getElementById('f-tipo').value;
  const forn=document.getElementById('f-forn').value.trim();
  const obs=document.getElementById('f-obs').value.trim();
  if(!nome) return toast('⚠️ Informe o nome do produto.');
  if(!tipo) return toast('⚠️ Selecione o tipo.');

  let gondola,estoque,alerta,acabamento,variacoes=null;

  if(modoAtual==='geral'){
    gondola=n('f-gondola');estoque=n('f-estoque');alerta=n('f-alerta')||5;
    acabamento='Geral';
    if(gondola===0&&estoque===0) return toast('⚠️ Informe ao menos uma quantidade.');
  } else {
    const pg=n('vp-g'),pe=n('vp-e'),dg=n('vd-g'),de=n('vd-e'),rg=n('vr-g'),re=n('vr-e');
    gondola=pg+dg+rg;estoque=pe+de+re;alerta=n('f-alerta-v')||5;
    acabamento='Variado';
    if(gondola===0&&estoque===0) return toast('⚠️ Informe ao menos uma quantidade.');
    variacoes={Prata:{gondola:pg,estoque:pe},Dourado:{gondola:dg,estoque:de},RoseGold:{gondola:rg,estoque:re}};
  }

  const reg={
    id:Date.now(),data:new Date().toISOString(),
    nome,ref,tipo,forn,obs,gondola,estoque,alerta,acabamento,variacoes,
    foto:fotoB64||null,por:USER.nome,
    movimentacoes:[{data:new Date().toISOString(),acao:'Check-in inicial',gondola,estoque,variacoes,por:USER.nome}]
  };

  const lista=getData();lista.unshift(reg);setData(lista);
  limparForm();atualizar();
  toast('✅ Produto registrado com sucesso!');
}

function limparForm(){
  ['f-nome','f-ref','f-forn','f-obs','f-gondola','f-estoque','f-alerta',
   'vp-g','vp-e','vd-g','vd-e','vr-g','vr-e','f-alerta-v']
    .forEach(id=>{const el=document.getElementById(id);if(el)el.value='';});
  document.getElementById('f-tipo').value='';
  document.getElementById('preview-img').style.display='none';
  document.getElementById('foto-input').value='';
  document.getElementById('prev-geral').style.display='none';
  document.getElementById('prev-var').textContent='';
  fotoB64=null;
  setModo('geral');
}

// REPOR
function abrirRepor(id){
  const r=getData().find(x=>x.id===id);if(!r)return;
  reporId=id;
  let info=`<strong>${r.nome}</strong><br>`;
  if(r.variacoes){
    Object.entries(r.variacoes).forEach(([k,v])=>{
      if(v.gondola>0||v.estoque>0){
        const nome=k==='RoseGold'?'Rose Gold':k;
        info+=`${icone(k)} ${nome}: 🛒${v.gondola} | 📦${v.estoque}<br>`;
      }
    });
  } else {
    info+=`🛒 Gôndola: <b>${r.gondola}</b> &nbsp; 📦 Estoque: <b>${r.estoque}</b>`;
  }
  document.getElementById('repor-info').innerHTML=info;

  const grp=document.getElementById('repor-var-group');
  grp.innerHTML='';
  document.getElementById('repor-var-sel').value='';

  if(r.variacoes){
    Object.entries(r.variacoes).forEach(([k,v])=>{
      const nome=k==='RoseGold'?'Rose Gold':k;
      const btn=document.createElement('button');
      btn.type='button';
      btn.className='var-sel-btn';
      btn.innerHTML=`${icone(k)} ${nome}<br><small>📦${v.estoque} disp.</small>`;
      btn.onclick=()=>{
        document.querySelectorAll('#repor-var-group .var-sel-btn').forEach(b=>b.classList.remove('ativo'));
        btn.classList.add('ativo');
        document.getElementById('repor-var-sel').value=k;
      };
      grp.appendChild(btn);
    });
  } else {
    const btn=document.createElement('button');
    btn.type='button';
    btn.className='var-sel-btn ativo';
    btn.innerHTML=`📦 Geral<br><small>📦${r.estoque} disp.</small>`;
    btn.onclick=()=>{
      document.querySelectorAll('#repor-var-group .var-sel-btn').forEach(b=>b.classList.remove('ativo'));
      btn.classList.add('ativo');
      document.getElementById('repor-var-sel').value='Geral';
    };
    document.getElementById('repor-var-sel').value='Geral';
    grp.appendChild(btn);
  }

  document.getElementById('repor-qtd').value='';
  document.getElementById('repor-modal').classList.add('open');
}

function fecharRepor(){document.getElementById('repor-modal').classList.remove('open');reporId=null;}

function confirmarRepor(){
  const qtd=parseInt(document.getElementById('repor-qtd').value)||0;
  const varSel=document.getElementById('repor-var-sel').value;
  if(qtd<=0) return toast('⚠️ Informe uma quantidade válida.');
  if(!varSel) return toast('⚠️ Selecione o acabamento.');
  const lista=getData();
  const idx=lista.findIndex(x=>x.id===reporId);if(idx<0)return;
  const r=lista[idx];

  if(r.variacoes&&varSel!=='Geral'){
    const v=r.variacoes[varSel];
    if(!v) return toast('⚠️ Variação não encontrada.');
    if(qtd>v.estoque) return toast(`⚠️ Estoque insuficiente! Disponível: ${v.estoque}`);
    v.gondola+=qtd;v.estoque-=qtd;
    r.gondola=Object.values(r.variacoes).reduce((s,x)=>s+x.gondola,0);
    r.estoque=Object.values(r.variacoes).reduce((s,x)=>s+x.estoque,0);
  } else {
    if(qtd>r.estoque) return toast(`⚠️ Estoque insuficiente! Disponível: ${r.estoque}`);
    r.gondola+=qtd;r.estoque-=qtd;
  }

  r.movimentacoes=r.movimentacoes||[];
  const nomeVar=varSel==='RoseGold'?'Rose Gold':varSel;
  r.movimentacoes.unshift({
    data:new Date().toISOString(),
    acao:`Reposição: ${qtd} un. → Gôndola (${nomeVar})`,
    gondola:r.gondola,estoque:r.estoque,
    variacoes:r.variacoes?JSON.parse(JSON.stringify(r.variacoes)):null,
    por:USER.nome
  });
  lista[idx]=r;setData(lista);
  fecharRepor();atualizar();
  toast(`✅ ${qtd} un. (${nomeVar}) movidas para a gôndola!`);
}

// EDITAR
function abrirEdit(id){
  if(!USER.isAdmin) return toast('🚫 Apenas o administrador pode editar.');
  const r=getData().find(x=>x.id===id);if(!r)return;
  document.getElementById('edit-id').value=id;
  document.getElementById('edit-nome').value=r.nome||'';
  document.getElementById('edit-ref').value=r.ref||'';
  document.getElementById('edit-tipo').value=r.tipo||'';
  document.getElementById('edit-forn').value=r.forn||'';
  document.getElementById('edit-alerta').value=r.alerta||5;
  document.getElementById('edit-obs').value=r.obs||'';

  const area=document.getElementById('edit-qtd-area');
  if(r.variacoes){
    area.innerHTML=`
      <div class="var-row"><div class="vt">🔘 Prata</div><div class="vc">
        <div><label>Gôndola</label><input type="number" id="ep-g" min="0" value="${r.variacoes.Prata.gondola}"/></div>
        <div><label>Estoque</label><input type="number" id="ep-e" min="0" value="${r.variacoes.Prata.estoque}"/></div>
      </div></div>
      <div class="var-row"><div class="vt">✨ Dourado</div><div class="vc">
        <div><label>Gôndola</label><input type="number" id="ed-g" min="0" value="${r.variacoes.Dourado.gondola}"/></div>
        <div><label>Estoque</label><input type="number" id="ed-e" min="0" value="${r.variacoes.Dourado.estoque}"/></div>
      </div></div>
      <div class="var-row"><div class="vt">🌸 Rose Gold</div><div class="vc">
        <div><label>Gôndola</label><input type="number" id="er-g" min="0" value="${r.variacoes.RoseGold.gondola}"/></div>
        <div><label>Estoque</label><input type="number" id="er-e" min="0" value="${r.variacoes.RoseGold.estoque}"/></div>
      </div></div>`;
  } else {
    area.innerHTML=`
      <div class="row2">
        <div class="field"><label>Gôndola</label><input type="number" id="eg-g" min="0" value="${r.gondola}"/></div>
        <div class="field"><label>Estoque</label><input type="number" id="eg-e" min="0" value="${r.estoque}"/></div>
      </div>`;
  }
  document.getElementById('edit-modal').classList.add('open');
}

function fecharEdit(){document.getElementById('edit-modal').classList.remove('open');}

function salvarEdit(){
  const id=parseInt(document.getElementById('edit-id').value);
  const lista=getData();
  const idx=lista.findIndex(x=>x.id===id);if(idx<0)return;
  const r=lista[idx];
  r.nome=document.getElementById('edit-nome').value.trim();
  r.ref=document.getElementById('edit-ref').value.trim();
  r.tipo=document.getElementById('edit-tipo').value;
  r.forn=document.getElementById('edit-forn').value.trim();
  r.alerta=parseInt(document.getElementById('edit-alerta').value)||5;
  r.obs=document.getElementById('edit-obs').value.trim();

  if(r.variacoes){
    r.variacoes.Prata.gondola=parseInt(document.getElementById('ep-g').value)||0;
    r.variacoes.Prata.estoque=parseInt(document.getElementById('ep-e').value)||0;
    r.variacoes.Dourado.gondola=parseInt(document.getElementById('ed-g').value)||0;
    r.variacoes.Dourado.estoque=parseInt(document.getElementById('ed-e').value)||0;
    r.variacoes.RoseGold.gondola=parseInt(document.getElementById('er-g').value)||0;
    r.variacoes.RoseGold.estoque=parseInt(document.getElementById('er-e').value)||0;
    r.gondola=Object.values(r.variacoes).reduce((s,x)=>s+x.gondola,0);
    r.estoque=Object.values(r.variacoes).reduce((s,x)=>s+x.estoque,0);
  } else {
    r.gondola=parseInt(document.getElementById('eg-g').value)||0;
    r.estoque=parseInt(document.getElementById('eg-e').value)||0;
  }

  r.movimentacoes=r.movimentacoes||[];
  r.movimentacoes.unshift({data:new Date().toISOString(),acao:'Edição manual (Admin)',gondola:r.gondola,estoque:r.estoque,por:USER.nome});
  lista[idx]=r;setData(lista);
  fecharEdit();atualizar();
  toast('💾 Registro atualizado!');
}

function excluir(id){
  if(!USER.isAdmin) return toast('🚫 Apenas o administrador pode excluir.');
  if(!confirm('Excluir este registro permanentemente?')) return;
  setData(getData().filter(r=>r.id!==id));
  atualizar();toast('🗑️ Registro excluído.');
}

// HELPERS
function isLow(r){return(r.gondola+r.estoque)<=(r.alerta||5);}
function fmt(iso){return new Date(iso).toLocaleString('pt-BR',{day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit'});}
function fmtC(iso){return new Date(iso).toLocaleString('pt-BR',{day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'});}
function icone(k){if(k==='Prata')return'🔘';if(k==='Dourado')return'✨';if(k==='RoseGold')return'🌸';return'📦';}
function pillCls(k){if(k==='Prata')return'prata';if(k==='Dourado')return'dourado';if(k==='RoseGold')return'rosegold';return'';}

function buildAlertas(lista){
  const low=lista.filter(r=>isLow(r));
  if(!low.length)return'';
  return`<div class="alerta-estoque"><strong>⚠️ ${low.length} produto(s) com estoque baixo</strong>
