        <select id="fea" onchange="rES()"><option value="">Todos acabamentos</option><option value="Geral">📦 Geral</option><option value="Prata">🔘 Prata</option><option value="Dourado">✨ Dourado</option><option value="Rose Gold">🌸 Rose Gold</option></select>
        <select id="fel" onchange="rES()"><option value="">Todos</option><option value="low">⚠️ Estoque baixo</option><option value="ok">✅ Estoque ok</option></select>
        <input type="text" id="feb" placeholder="🔍 Nome ou código..." oninput="rES()" style="flex:1;min-width:130px;"/>
      </div>
      <div class="hw" id="hes"></div>
    </div>
  </div>

  <!-- RELATÓRIO -->
  <div class="pan" id="tab-re">
    <div class="pf">
      <div class="pp"><label>Início</label><input type="date" id="ri"/></div>
      <div class="pp"><label>Fim</label><input type="date" id="rf2"/></div>
      <div class="pp"><label>Tipo</label><select id="rt2"><option value="">Todos</option><option value="Joia">Joia</option><option value="Bijuteria">Bijuteria</option><option value="Semijoia">Semijoia</option><option value="Acessório">Acessório</option><option value="Outro">Outro</option></select></div>
      <div class="pp"><label>Acabamento</label><select id="ra"><option value="">Todos</option><option value="Geral">📦 Geral</option><option value="Prata">🔘 Prata</option><option value="Dourado">✨ Dourado</option><option value="Rose Gold">🌸 Rose Gold</option></select></div>
      <div class="pp"><label>Usuário</label><select id="ru"><option value="">Todos</option><option value="Administrador">Administrador</option><option value="Hellen">Hellen</option></select></div>
      <button class="btn bp" style="width:auto;padding:9px 20px;" onclick="gRel()">🔍 Gerar</button>
      <button class="bk" onclick="expRelCSV()">⬇️ CSV</button>
    </div>
    <div class="rg2" id="rca"></div>
    <div class="card" style="padding:20px;"><h2>Detalhamento</h2>
      <div style="overflow-x:auto;"><table class="rt"><thead><tr><th>Data</th><th>Código</th><th>Produto</th><th>Tipo</th><th>Acabamento</th><th>Gôndola</th><th>Estoque</th><th>Total</th><th>Por</th></tr></thead><tbody id="rtb"></tbody></table></div>
    </div>
  </div>

  <!-- ADMIN -->
  <div class="pan" id="tab-ad">
    <div class="card"><h2>⚙️ Painel Administrativo</h2>
      <p style="font-size:12px;color:var(--mt);margin-bottom:16px;">Apenas administrador pode editar ou excluir.</p>
      <div class="fts"><input type="text" id="fab" placeholder="🔍 Buscar..." oninput="rAD()" style="flex:1;"/></div>
      <div class="hw" id="had"></div>
    </div>
  </div>
</div>

<!-- MODAL REPOR -->
<div class="mo" id="rm">
  <div class="rb">
    <h3>🔄 Repor Gôndola</h3><p>Mover unidades do estoque para a gôndola</p>
    <div class="ri" id="rmi">—</div>
    <span class="ssl">Selecione o acabamento a repor</span>
    <div class="ssg" id="rvg"></div>
    <input type="hidden" id="rvs" value=""/>
    <input type="number" id="rq" min="1" placeholder="Quantidade"/>
    <div class="rbs"><button class="rcl" onclick="fRep()">Cancelar</button><button class="rok" onclick="cRep()">✅ Confirmar</button></div>
  </div>
</div>

<!-- MODAL EDITAR -->
<div class="eo" id="em2">
  <div class="eb">
    <h3>✏️ Editar Registro</h3>
    <input type="hidden" id="eid"/>
    <div class="fi"><label>Nome</label><input type="text" id="en2"/></div>
    <div class="r2">
      <div class="fi"><label>Código</label><input type="text" id="er2"/></div>
      <div class="fi"><label>Tipo</label><select id="eti"><option value="Joia">Joia</option><option value="Bijuteria">Bijuteria</option><option value="Semijoia">Semijoia</option><option value="Acessório">Acessório</option><option value="Outro">Outro</option></select></div>
    </div>
    <div class="fi"><label>Fornecedor</label><input type="text" id="efo"/></div>
    <div id="eqa"></div>
    <div class="fi"><label>Alertar abaixo de</label><input type="number" id="eal" min="0"/></div>
    <div class="fi"><label>Observações</label><textarea id="eob"></textarea></div>
    <div style="display:flex;gap:10px;margin-top:8px;">
      <button class="btn" style="flex:1;background:#f0f0f0;color:#666;border:none;cursor:pointer;" onclick="fEdit()">Cancelar</button>
      <button class="btn bp" style="flex:2;" onclick="sEdit()">💾 Salvar</button>
    </div>
  </div>
</div>

<div id="toast"></div>

<script>
const US={admin:{s:'geor2024',n:'Administrador',a:true},hellen:{s:'hellen123',n:'Hellen',a:false}};
let U=null,RI=null,RF=[],MD='g';

function login(){
  const u=document.getElementById('lu').value.trim().toLowerCase();
  const s=document.getElementById('lp').value;
  const er=document.getElementById('le');
  if(US[u]&&US[u].s===s){
    U={k:u,...US[u]};er.style.display='none';
    document.getElementById('ls').style.display='none';
    document.getElementById('si').style.display='block';
    document.getElementById('ub').innerHTML=`👤 ${U.n}${U.a?'<span class="at">ADMIN</span>':''}`;
    if(U.a) document.querySelectorAll('.adm').forEach(e=>e.style.display='');
    const h=new Date(),i=new Date(h.getFullYear(),h.getMonth(),1);
    document.getElementById('ri').value=i.toISOString().slice(0,10);
    document.getElementById('rf2').value=h.toISOString().slice(0,10);
    upd();
  } else er.style.display='block';
}
function logout(){U=null;document.getElementById('ls').style.display='flex';document.getElementById('si').style.display='none';document.getElementById('lu').value='';document.getElementById('lp').value='';}

function setM(m){
  MD=m;
  document.getElementById('bmg').classList.toggle('on',m==='g');
  document.getElementById('bmv').classList.toggle('on',m==='v');
  document.getElementById('bg').style.display=m==='g'?'block':'none';
  document.getElementById('bv').style.display=m==='v'?'block':'none';
}
function pg(){
  const g=nv('fg'),e=nv('fe'),el=document.getElementById('ptg');
  if(g===0&&e===0){el.style.display='none';return;}
  el.style.display='block';el.textContent=`∑ Total: ${g+e} | 🛒 Gôndola: ${g} | 📦 Estoque: ${e}`;
}
function pv(){
  const pg2=nv('vpg'),pe=nv('vpe'),dg=nv('vdg'),de=nv('vde'),rg=nv('vrg'),re=nv('vre');
  const tg=pg2+dg+rg,te=pe+de+re;
  document.getElementById('ptv').textContent=`∑ Total: ${tg+te} | 🛒 Gôndola: ${tg} | 📦 Estoque: ${te}`;
}
function nv(id){return parseInt(document.getElementById(id).value)||0;}

function aba(id){
  document.querySelectorAll('.tab').forEach((t,i)=>t.classList.toggle('active',['ci','es','re','ad'][i]===id));
  document.querySelectorAll('.pan').forEach(p=>p.classList.remove('active'));
  document.getElementById('tab-'+id).classList.add('active');
  if(id==='es')rES();if(id==='re')gRel();if(id==='ad')rAD();
}

function gD(){return JSON.parse(localStorage.getItem('geor_v3')||'[]');}
function sD(d){localStorage.setItem('geor_v3',JSON.stringify(d));}

let FB=null;
document.getElementById('fi').addEventListener('change',function(e){
  const f=e.target.files[0];if(!f)return;
  const r=new FileReader();
  r.onload=ev=>{FB=ev.target.result;const i=document.getElementById('pi');i.src=FB;i.style.display='block';};
  r.readAsDataURL(f);
});

function registrar(){
  const nm=document.getElementById('fn').value.trim();
  const rf=document.getElementById('fr').value.trim();
  const tp=document.getElementById('ft').value;
  const fo=document.getElementById('ff').value.trim();
  const ob=document.getElementById('fo').value.trim();
  if(!nm)return toast('⚠️ Informe o nome.');
  if(!tp)return toast('⚠️ Selecione o tipo.');
  let g,e,al,ac,vr=null;
  if(MD==='g'){
    g=nv('fg');e=nv('fe');al=nv('fa2')||5;ac='Geral';
    if(g===0&&e===0)return toast('⚠️ Informe ao menos uma quantidade.');
  } else {
    const pg2=nv('vpg'),pe=nv('vpe'),dg=nv('vdg'),de=nv('vde'),rg=nv('vrg'),re=nv('vre');
    g=pg2+dg+rg;e=pe+de+re;al=nv('fav')||5;ac='Variado';
    if(g===0&&e===0)return toast('⚠️ Informe ao menos uma quantidade.');
    vr={Prata:{g:pg2,e:pe},Dourado:{g:dg,e:de},RoseGold:{g:rg,e:re}};
  }
  const reg={id:Date.now(),dt:new Date().toISOString(),nm,rf,tp,fo,ob,g,e,al,ac,vr,ft:FB||null,pr:U.n,
    mv:[{dt:new Date().toISOString(),ac2:'Check-in inicial',g,e,vr,pr:U.n}]};
  const l=gD();l.unshift(reg);sD(l);
  limpar();upd();toast('✅ Produto registrado!');
}

function limpar(){
  ['fn','fr','ff','fo','fg','fe','fa2','vpg','vpe','vdg','vde','vrg','vre','fav']
    .forEach(id=>{const el=document.getElementById(id);if(el)el.value='';});
  document.getElementById('ft').value='';
  document.getElementById('pi').style.display='none';
  document.getElementById('fi').value='';
  document.getElementById('ptg').style.display='none';
  document.getElementById('ptv').textContent='';
  FB=null;setM('g');
}

function abrirR(id){
  const r=gD().find(x=>x.id===id);if(!r)return;
  RI=id;
  let inf=`<strong>${r.nm}</strong><br>`;
  if(r.vr){
    Object.entries(r.vr).forEach(([k,v])=>{
      if(v.g>0||v.e>0){const n2=k==='RoseGold'?'Rose Gold':k;inf+=`${ico(k)} ${n2}: 🛒${v.g} | 📦${v.e}<br>`;}
    });
  } else inf+=`🛒 Gôndola: <b>${r.g}</b> &nbsp; 📦 Estoque: <b>${r.e}</b>`;
  document.getElementById('rmi').innerHTML=inf;
  const grp=document.getElementById('rvg');grp.innerHTML='';
  document.getElementById('rvs').value='';
  if(r.vr){
    Object.entries(r.vr).forEach(([k,v])=>{
      const n2=k==='RoseGold'?'Rose Gold':k;
      const b=document.createElement('button');b.type='button';b.className='ssb';
      b.innerHTML=`${ico(k)} ${n2}<br><small>📦${v.e} disp.</small>`;
      b.onclick=()=>{document.querySelectorAll('#rvg .ssb').forEach(x=>x.classList.remove('on'));b.classList.add('on');document.getElementById('rvs').value=k;};
      grp.appendChild(b);
    });
  } else {
    const b=document.createElement('button');b.type='button';b.className='ssb on';
    b.innerHTML=`📦 Geral<br><small>📦${r.e} disp.</small>`;
    b.onclick=()=>{document.querySelectorAll('#rvg .ssb').forEach(x=>x.classList.remove('on'));b.classList.add('on');document.getElementById('rvs').value='Geral';};
    document.getElementById('rvs').value='Geral';grp.appendChild(b);
  }
  document.getElementById('rq').value='';
  document.getElementById('rm').classList.add('op');
}
function fRep(){document.getElementById('rm').classList.remove('op');RI=null;}
function cRep(){
  const q=parseInt(document.getElementById('rq').value)||0;
  const vs=document.getElementById('rvs').value;
  if(q<=0)return toast('⚠️ Quantidade inválida.');
  if(!vs)return toast('⚠️ Selecione o acabamento.');
  const l=gD();const idx=l.findIndex(x=>x.id===RI);if(idx<0)return;
  const r=l[idx];
  if(r.vr&&vs!=='Geral'){
    const v=r.vr[vs];if(!v)return toast('⚠️ Variação não encontrada.');
    if(q>v.e)return toast(`⚠️ Estoque insuficiente! Disponível: ${v.e}`);
    v.g+=q;v.e-=q;
    r.g=Object.values(r.vr).reduce((s,x)=>s+x.g,0);
    r.e=Object.values(r.vr).reduce((s,x)=>s+x.e,0);
  } else {
    if(q>r.e)return toast(`⚠️ Estoque insuficiente! Disponível: ${r.e}`);
    r.g+=q;r.e-=q;
  }
  r.mv=r.mv||[];
  const nv2=vs==='RoseGold'?'Rose Gold':vs;
  r.mv.unshift({dt:new Date().toISOString(),ac2:`Reposição: ${q} un. → Gôndola (${nv2})`,g:r.g,e:r.e,vr:r.vr?JSON.parse(JSON.stringify(r.vr)):null,pr:U.n});
  l[idx]=r;sD(l);fRep();upd();toast(`✅ ${q} un. (${nv2}) movidas para a gôndola!`);
}

function abrirE(id){
  if(!U.a)return toast('🚫 Apenas administrador.');
  const r=gD().find(x=>x.id===id);if(!r)return;
  document.getElementById('eid').value=id;
  document.getElementById('en2').value=r.nm||'';
  document.getElementById('er2').value=r.rf||'';
  document.getElementById('eti').value=r.tp||'';
  document.getElementById('efo').value=r.fo||'';
  document.getElementById('eal').value=r.al||5;
  document.getElementById('eob').value=r.ob||'';
  const ar=document.getElementById('eqa');
  if(r.vr){
    ar.innerHTML=`
      <div class="vr"><div class="vt">🔘 Prata</div><div class="vc"><div><label>Gôndola</label><input type="number" id="epg" min="0" value="${r.vr.Prata.g}"/></div><div><label>Estoque</label><input type="number" id="epe" min="0" value="${r.vr.Prata.e}"/></div></div></div>
      <div class="vr"><div class="vt">✨ Dourado</div><div class="vc"><div><label>Gôndola</label><input type="number" id="edg" min="0" value="${r.vr.Dourado.g}"/></div><div><label>Estoque</label><input type="number" id="ede" min="0" value="${r.vr.Dourado.e}"/></div></div></div>
      <div class="vr"><div class="vt">🌸 Rose Gold</div><div class="vc"><div><label>Gôndola</label><input type="number" id="erg" min="0" value="${r.vr.RoseGold.g}"/></div><div><label>Estoque</label><input type="number" id="ere" min="0" value="${r.vr.RoseGold.e}"/></div></div></div>`;
  } else {
    ar.innerHTML=`<div class="r2"><div class="fi"><label>Gôndola</label><input type="number" id="egg" min="0" value="${r.g}"/></div><div class="fi"><label>Estoque</label><input type="number" id="ege" min="0" value="${r.e}"/></div></div>`;
  }
  document.getElementById('em2').classList.add('op');
}
function fEdit(){document.getElementById('em2').classList.remove('op');}
function sEdit(){
  const id=parseInt(document.getElementById('eid').value);
  const l=gD();const idx=l.findIndex(x=>x.id===id);if(idx<0)return;
  const r=l[idx];
  r.nm=document.getElementById('en2').value.trim();
  r.rf=document.getElementById('er2').value.trim();
  r.tp=document.getElementById('eti').value;
  r.fo=document.getElementById('efo').value.trim();
  r.al=parseInt(document.getElementById('eal').value)||5;
  r.ob=document.getElementById('eob').value.trim();
  if(r.vr){
    r.vr.Prata.g=parseInt(document.getElementById('epg').value)||0;
    r.vr.Prata.e=parseInt(document.getElementById('epe').value)||0;
    r.vr.Dourado.g=parseInt(document.getElementById('edg').value)||0;
    r.vr.Dourado.e=parseInt(document.getElementById('ede').value)||0;
    r.vr.RoseGold.g=parseInt(document.getElementById('erg').value)||0;
    r.vr.RoseGold.e=parseInt(document.getElementById('ere').value)||0;
    r.g=Object.values(r.vr).reduce((s,x)=>s+x.g,0);
    r.e=Object.values(r.vr).reduce((s,x)=>s+x.e,0);
  } else {
    r.g=parseInt(document.getElementById('egg').value)||0;
    r.e=parseInt(document.getElementById('ege').value)||0;
  }
  r.mv=r.mv||[];
  r.mv.unshift({dt:new Date().toISOString(),ac2:'Edição (Admin)',g:r.g,e:r.e,pr:U.n});
  l[idx]=r;sD(l);fEdit();upd();toast('💾 Registro atualizado!');
}

function excluir(id){
  if(!U.a)return toast('🚫 Apenas administrador.');
  if(!confirm('Excluir permanentemente?'))return;
  sD(gD().filter(r=>r.id!==id));upd();toast('🗑️ Excluído.');
}

function isLow(r){return(r.g+r.e)<=(r.al||5);}
function fmt(s){return new Date(s).toLocaleString('pt-BR',{day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit'});}
function fmtC(s){return new Date(s).toLocaleString('pt-BR',{day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'});}
function ico(k){return k==='Prata'?'🔘':k==='Dourado'?'✨':k==='RoseGold'?'🌸':'📦';}
function pcl(k){return k==='Prata'?'pr':k==='Dourado'?'do':k==='RoseGold'?'rg':'';}
function tcl(tp){return tp==='Joia'?'J':tp==='Bijuteria'?'B':tp==='Semijoia'?'S':tp==='Acessório'?'A':'O';}

function bldAlerta(l){
  const lw=l.filter(r=>isLow(r));if(!lw.length)return'';
  return`<div class="ae"><strong>⚠️ ${lw.length} produto(s) com estoque baixo</strong>${lw.map(r=>`<div class="ai">${r.nm}${r.rf?` (${r.rf})`:''} — 🛒${r.g} | 📦${r.e}</div>`).join('')}</div>`;
}
function bldStats(l,id){
  const t=l.length,g=l.reduce((s,r)=>s+r.g,0),e=l.reduce((s,r)=>s+r.e,0),lw=l.filter(r=>isLow(r)).length;
  document.getElementById(id).innerHTML=`<div class="sb"><div class="nm">${t}</div><div class="lb">Produtos</div></div><div class="sb"><div class="nm">${g}</div><div class="lb">Na Gôndola</div></div><div class="sb"><div class="nm">${e}</div><div class="lb">No Estoque</div></div><div class="sb ${lw>0?'wn':''}"><div class="nm">${lw}</div><div class="lb">Alerta Baixo</div></div>`;
}

function card(r,mv){
  const lw=isLow(r);
  let varHtml='';
  if(r.vr){
    varHtml=`<div class="vd"><div class="vdt">Variações</div>`;
    Object.entries(r.vr).forEach(([k,v])=>{
      if(v.g>0||v.e>0){const n2=k==='RoseGold'?'Rose Gold':k;varHtml+=`<div class="vl"><span class="vn">${ico(k)} ${n2}</span><span class="vq">🛒${v.g} | 📦${v.e}</span></div>`;}
    });
    varHtml+=`</div>`;
  }
  const acPill=r.vr?`<span class="pl ${pcl('')}">🔘✨ Variado</span>`:`<span class="pl ${pcl(r.ac)}">${ico(r.ac)} ${r.ac}</span>`;
  const movHtml=mv&&r.mv&&r.mv.length?`<div class="ml">${r.mv.slice(0,4).map(m=>`<div class="mi">📌 ${fmtC(m.dt)} — ${m.ac2} por ${m.pr}</div>`).join('')}</div>`:'';
  return`<div class="en ${lw?'al':''}">
    ${r.ft?`<img src="${r.ft}" alt=""/>`:`<div class="ni">💎</div>`}
    <div class="ei">
      <h3>${r.nm}</h3>
      ${r.rf?`<div class="rf">🏷️ ${r.rf}</div>`:''}
      <div class="me"><span class="tb ${tcl(r.tp)}">${r.tp}</span>${r.fo?` · ${r.fo}`:''}</div>
      <div class="pls">${acPill}<span class="pl go">🛒 Gôndola: ${r.g}</span><span class="pl es">📦 Estoque: ${r.e}</span><span class="pl to">∑ ${r.g+r.e}</span>${lw?`<span class="pl lw">⚠️ Baixo</span>`:''}</div>
      ${varHtml}
      ${r.ob?`<div class="ob">📝 ${r.ob}</div>`:''}
      ${movHtml}
      <div class="rp">👤 ${r.pr||'—'} em ${fmt(r.dt)}</div>
    </div>
    <div class="ea">
      <button class="bs" onclick="abrirR(${r.id})">🔄 Repor</button>
      ${U.a?`<button class="bw" onclick="abrirE(${r.id})">✏️ Editar</button><button class="bd" onclick="excluir(${r.id})">🗑️</button>`:`<span style="font-size:10px;color:#ccc;">🔒</span>`}
    </div>
  </div>`;
}

function filtroAcab(r,fa){
  if(!fa)return true;
  if(fa==='Geral')return r.ac==='Geral';
  if(!r.vr)return false;
  const k=fa==='Rose Gold'?'RoseGold':fa;
  return r.vr[k]&&(r.vr[k].g>0||r.vr[k].e>0);
}

function rCI(){
  const ft=document.getElementById('ftt').value;
  const fa=document.getElementById('fta').value;
  const fb=document.getElementById('ftb').value.toLowerCase();
  let l=gD();
  bldStats(l,'sc');document.getElementById('at').innerHTML=bldAlerta(l);
  if(ft)l=l.filter(r=>r.tp===ft);
  l=l.filter(r=>filtroAcab(r,fa));
  if(fb)l=l.filter(r=>r.nm.toLowerCase().includes(fb)||(r.rf||'').toLowerCase().includes(fb));
  const el=document.getElementById('hci');
  el.innerHTML=l.length?l.map(r=>card(r,false)).join(''):`<div class="em"><div class="ic">📭</div><p>Nenhum registro.</p></div>`;
}

function rES(){
  const ft=document.getElementById('fet').value;
  const fa=document.getElementById('fea').value;
  const fl=document.getElementById('fel').value;
  const fb=document.getElementById('feb').value.toLowerCase();
  let l=gD();
  bldStats(l,'ses');document.getElementById('aes').innerHTML=bldAlerta(l);
  if(ft)l=l.filter(r=>r.tp===ft);
  l=l.filter(r=>filtroAcab(r,fa));
  if(fl==='low')l=l.filter(r=>isLow(r));
  if(fl==='ok')l=l.filter(r=>!isLow(r));
  if(fb)l=l.filter(r=>r.nm.toLowerCase().includes(fb)||(r.rf||'').toLowerCase().includes(fb));
  const el=document.getElementById('hes');
  el.innerHTML=l.length?l.map(r=>card(r,true)).join(''):`<div class="em"><div class="ic">📭</div><p>Nenhum produto.</p></div>`;
}

function rAD(){
  const fb=(document.getElementById('fab').value||'').toLowerCase();
  let l=gD();
  if(fb)l=l.filter(r=>r.nm.toLowerCase().includes(fb)||(r.rf||'').toLowerCase().includes(fb));
  const el=document.getElementById('had');
